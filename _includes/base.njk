<!DOCTYPE html>
<html lang="en" data-theme="{{ site.theme }}" data-font="{{ appearance.display_font }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {% endif %}{{ site.brand }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.brand }}">
<meta property="og:title" content="{% if title %}{{ title }} — {{ site.brand }}{% else %}{{ site.brand }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/brand/og.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title }} — {{ site.brand }}{% else %}{{ site.brand }}{% endif %}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ site.url }}/assets/brand/og.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=League+Gothic&family=Barlow+Condensed:wght@500;600&family=Oswald:wght@400;500;600&family=Rajdhani:wght@400;500;600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png?v={{ build.v }}">
<link rel="icon" type="image/png" sizes="512x512" href="/assets/brand/favicon.png?v={{ build.v }}">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png?v={{ build.v }}">
<link rel="stylesheet" href="/assets/css/style.css?v={{ build.v }}">
</head>
<body>
{% if (site.sky_layer or site.adaptive_background) and site.theme == "black" %}<div id="sky-layer" aria-hidden="true" data-stars="{{ "true" if site.sky_layer else "false" }}" data-adaptive="{{ "true" if site.adaptive_background else "false" }}"></div>{% endif %}
<header class="site-header">
  <a class="brand" href="/#home">
    {% if site.header_globe %}<span id="globe" class="brand-globe" aria-hidden="true" title="Daylight on Earth right now"></span>{% endif %}
    <span>{{ site.brand }}</span>
  </a>
  <nav class="site-nav" id="site-nav">
    {% for item in home.nav %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
  </nav>
  <div class="header-actions">
    <a class="btn btn-ghost btn-small" href="/#contact">Request a Deck</a>
    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer" id="contact-footer">
  <p>{{ site.copyright }}</p>
  <nav class="footer-links">
    {% for l in site.footer_links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
  </nav>
  <nav class="footer-social">
    <a href="{{ site.linkedin }}">LinkedIn</a>
    <a href="{{ site.instagram }}">Instagram</a>
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  </nav>
</footer>
<script src="/assets/js/main.js?v={{ build.v }}"></script>
{% if site.header_globe %}<script src="/assets/js/globe.js?v={{ build.v }}" defer></script>{% endif %}
{% if (site.sky_layer or site.adaptive_background) and site.theme == "black" %}<script src="/assets/js/sky.js?v={{ build.v }}" defer></script>{% endif %}
</body>
</html>
