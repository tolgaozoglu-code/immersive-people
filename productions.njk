---
layout: base.njk
description: 36 immersive productions across eight thematic worlds, licensed to travel between venues and markets.
title: Productions
permalink: /productions/
---
<section class="section">
  <h2 class="section-title">The Library</h2>
  <p class="section-intro">36 productions. Eight worlds. One licence.</p>
  {% for w in worlds %}
  <details class="world-group" id="{{ w.slug }}" {% if loop.first %}open{% endif %}>
    <summary class="world-head">
      <span class="world-title">{{ w.name }}</span>
      <span class="world-count">{{ w.count }}</span>
      <span class="world-desc">{{ w.description }}</span>
    </summary>
    <div class="prod-grid">
      {% for p in collections.production %}
      {% if p.data.world == w.name %}
      <a class="prod-card" href="{{ p.url }}">
        <span class="prod-art"><img src="{{ p.data.image or p.data.keyart }}" alt="{{ p.data.title }}" loading="lazy"></span>
        <span class="prod-cat">{{ p.data.category }}</span>
        <span class="prod-name">{{ p.data.title }}</span>
        <span class="prod-tag">{{ p.data.tagline }}</span>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </details>
  {% endfor %}
</section>
